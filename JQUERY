JQUERY
<!DOCTYPE html>
<html>
<head>
    <title>My Mobile Website</title>

    <!-- jQuery Mobile CSS -->
    <link rel="stylesheet"
    href="https://code.jquery.com/mobile/1.4.5/jquery.mobile-1.4.5.min.css">

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-1.11.1.min.js"></script>

    <!-- jQuery Mobile -->
    <script src="https://code.jquery.com/mobile/1.4.5/jquery.mobile-1.4.5.min.js"></script>
</head>

<body>

<!-- Home Page -->
<div data-role="page" id="home">

    <!-- Header -->
    <div data-role="header">
        <h1>My Mobile Site</h1>
    </div>

    <!-- Main Content -->
    <div data-role="content">
        <h2>Welcome</h2>
        <p>This is a simple jQuery Mobile website.</p>

        <a href="#about" data-role="button">
            Go to About Page
        </a>
    </div>

    <!-- Footer -->
    <div data-role="footer">
        <h4>Created by Arpit</h4>
    </div>

</div>

<!-- About Page -->
<div data-role="page" id="about">

    <div data-role="header">
        <h1>About</h1>
    </div>

    <div data-role="content">
        <p>This website is made using jQuery Mobile.</p>

        <a href="#home" data-role="button">
            Back to Home
        </a>
    </div>

    <div data-role="footer">
        <h4>Thank You</h4>
    </div>

</div>

</body>
</html>
