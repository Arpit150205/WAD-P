<!-- ========================= -->
<!-- HTML + CSS + BOOTSTRAP -->
<!-- Responsive Web Page -->
<!-- ========================= -->

<!DOCTYPE html>
<html lang="en">

<head>

    <!-- HTML PART -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Responsive Web Page</title>


    <!-- ========================= -->
    <!-- BOOTSTRAP CDN -->
    <!-- ========================= -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


    <!-- ========================= -->
    <!-- CSS PART -->
    <!-- ========================= -->

    <style>

        body{
            background-color:#f4f4f4;
            font-family:Arial, sans-serif;
        }

        .navbar{
            background-color:#0d6efd;
        }

        .navbar-brand,
        .nav-link{
            color:white !important;
            font-weight:bold;
        }

        .hero{
            height:90vh;
            display:flex;
            justify-content:center;
            align-items:center;
            text-align:center;
            background:linear-gradient(to right,#0d6efd,#6610f2);
            color:white;
        }

        .card{
            transition:0.3s;
        }

        .card:hover{
            transform:scale(1.05);
        }

        footer{
            background-color:#212529;
            color:white;
            text-align:center;
            padding:15px;
            margin-top:40px;
        }

    </style>

</head>

<body>


    <!-- ========================= -->
    <!-- HTML + BOOTSTRAP NAVBAR -->
    <!-- ========================= -->

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <a class="navbar-brand" href="#">My Website</a>

            <button class="navbar-toggler bg-light"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">Contact</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- ========================= -->
    <!-- HTML + BOOTSTRAP HERO -->
    <!-- ========================= -->

    <section class="hero">

        <div>

            <h1 class="display-4 fw-bold">
                Responsive Web Page
            </h1>

            <p class="lead">
                Developed using HTML, CSS and Bootstrap
            </p>

            <button class="btn btn-light btn-lg">
                Learn More
            </button>

        </div>

    </section>


    <!-- ========================= -->
    <!-- HTML + BOOTSTRAP CARDS -->
    <!-- ========================= -->

    <div class="container mt-5">

        <div class="row g-4">

            <!-- CARD 1 -->

            <div class="col-md-4">

                <div class="card shadow">

                    <div class="card-body text-center">

                        <h3 class="card-title">
                            HTML
                        </h3>

                        <p class="card-text">
                            HTML is used to create structure of web pages.
                        </p>

                        <button class="btn btn-primary">
                            Read More
                        </button>

                    </div>

                </div>

            </div>


            <!-- CARD 2 -->

            <div class="col-md-4">

                <div class="card shadow">

                    <div class="card-body text-center">

                        <h3 class="card-title">
                            CSS
                        </h3>

                        <p class="card-text">
                            CSS is used for styling and designing.
                        </p>

                        <button class="btn btn-success">
                            Read More
                        </button>

                    </div>

                </div>

            </div>


            <!-- CARD 3 -->

            <div class="col-md-4">

                <div class="card shadow">

                    <div class="card-body text-center">

                        <h3 class="card-title">
                            Bootstrap
                        </h3>

                        <p class="card-text">
                            Bootstrap helps create responsive websites.
                        </p>

                        <button class="btn btn-danger">
                            Read More
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- HTML + BOOTSTRAP FORM -->
    <!-- ========================= -->

    <div class="container mt-5">

        <h2 class="text-center mb-4">
            Contact Form
        </h2>

        <form>

            <div class="mb-3">

                <input type="text"
                       class="form-control"
                       placeholder="Enter Name">

            </div>

            <div class="mb-3">

                <input type="email"
                       class="form-control"
                       placeholder="Enter Email">

            </div>

            <div class="mb-3">

                <textarea class="form-control"
                          rows="5"
                          placeholder="Enter Message"></textarea>

            </div>

            <div class="text-center">

                <button class="btn btn-primary">
                    Submit
                </button>

            </div>

        </form>

    </div>


    <!-- ========================= -->
    <!-- HTML + BOOTSTRAP FOOTER -->
    <!-- ========================= -->

    <footer>

        <p>
            © 2026 Responsive Website | Practical Exam
        </p>

    </footer>


    <!-- ========================= -->
    <!-- BOOTSTRAP JS -->
    <!-- ========================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
